{
	"$comment": "Published on <Name>/json. The status and link objects follow G4KLX's gateway programs (YSFGateway, P25Gateway, NXDNGateway). M17 adds the module field and the rejected and shutdown reasons. A completed link is action linking with reason established. The link object is retained.",

	"$defs": {
		"timestamp": {"type": "string"},
		"reflector": {"type": "string"},
		"module": {"type": "string", "pattern": "^[A-Z]$"},
		"action": {"type": "string", "enum": ["linking", "unlinked", "failed", "relinking"]},
		"protocol": {"type": "string", "enum": ["m17"]},
		"reason": {"type": "string", "enum": ["user", "timer", "remote", "startup", "established", "rejected", "shutdown"]}
	},

	"status": {
		"type": "object",
		"timestamp": {"$ref": "#/$defs/timestamp"},
		"message": {"type": "string"},
		"required": ["timestamp", "message"]
	},

	"link": {
		"type": "object",
		"timestamp": {"$ref": "#/$defs/timestamp"},
		"action": {"$ref": "#/$defs/action"},
		"reason": {"$ref": "#/$defs/reason"},
		"reflector": {"$ref": "#/$defs/reflector"},
		"module": {"$ref": "#/$defs/module"},
		"protocol": {"$ref": "#/$defs/protocol"},
		"required": ["timestamp", "action", "protocol"]
	}
}
